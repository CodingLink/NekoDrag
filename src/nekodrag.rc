#include <windows.h>
#include "resource.h"

IDI_APPICON ICON "assets/app.ico"
IDI_TRAYICON ICON "assets/tray.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG | VS_FF_PRERELEASE
#else
 FILEFLAGS VS_FF_PRERELEASE
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "NekoDrag"
            VALUE "FileDescription", "NekoDrag Window Utility"
            VALUE "FileVersion", "0.1.0-beta.4"
            VALUE "InternalName", "NekoDrag"
            VALUE "OriginalFilename", "NekoDrag.exe"
            VALUE "ProductName", "NekoDrag"
            VALUE "ProductVersion", "0.1.0-beta.4"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
