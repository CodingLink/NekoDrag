#include <windows.h>
#include "resource.h"
#include "nekodrag_version.h"

#if NEKODRAG_VERSION_PRERELEASE
#define NEKODRAG_FF_PRERELEASE VS_FF_PRERELEASE
#else
#define NEKODRAG_FF_PRERELEASE 0
#endif

IDI_APPICON ICON "assets/app.ico"
IDI_TRAYICON ICON "assets/tray.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION NEKODRAG_VERSION_MAJOR,NEKODRAG_VERSION_MINOR,NEKODRAG_VERSION_PATCH,0
 PRODUCTVERSION NEKODRAG_VERSION_MAJOR,NEKODRAG_VERSION_MINOR,NEKODRAG_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG | NEKODRAG_FF_PRERELEASE
#else
 FILEFLAGS NEKODRAG_FF_PRERELEASE
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "NekoDrag"
            VALUE "FileDescription", "NekoDrag Window Utility"
            VALUE "FileVersion", NEKODRAG_VERSION_STRING
            VALUE "InternalName", "NekoDrag"
            VALUE "OriginalFilename", "NekoDrag.exe"
            VALUE "ProductName", "NekoDrag"
            VALUE "ProductVersion", NEKODRAG_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
